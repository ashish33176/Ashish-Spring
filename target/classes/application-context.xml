<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans 
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    <bean name="add1" class="com.learning.model.Address">
       <property name="city" value="GZB"/>
       <property name="state" value="UP"/> 
    </bean>

    <bean name="emp1" class ="com.learning.model.Employee">
     <property name="id" value="111"/>
     <property name="name" value="Vishal"/>
     <property name="gender" value="male"/>
     <property name="salary" value="100091"/>
     <property name="address" ref="add1"/>
    </bean>
    
    
    <bean name="add2" class="com.learning.model.Address">
       <constructor-arg name="city" value="Gurgaon"/>
       <constructor-arg name="state" value="HR"/> 
    </bean>



    <bean name="emp2" class ="com.learning.model.Employee">
      <constructor-arg name="id" value="112"/>
      <constructor-arg name="name" value="Sarita"/>
      <constructor-arg name="gender" value="female"/>
      <constructor-arg name="salary" value="100091"/>
      <constructor-arg name="address" ref="add2"/>
     </bean>


</beans>